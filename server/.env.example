# Copy to .env and fill in real values. Never commit .env itself (already gitignored).
#
# Every variable here is read by server/src/main/resources/application*.properties. Full
# purpose/required/default/consequence-if-missing detail for each one lives in
# docs/CONFIG-REFERENCE.md (SYSTEM 04 TASK 4.1) — this file intentionally does not repeat
# that detail, only the variable name and a safe example/placeholder value.
#
# Rewritten under SYSTEM 04 to match what the app actually reads — the previous version had
# drifted: several names here were never real config surface (PORT, MAX_FILE_SIZE, EMAIL_FROM,
# APP_ENV, TIMEZONE, GOOGLE_CLIENT_ID/OAUTH2_* — no OAuth2 integration exists in this codebase —
# LOG_LEVEL_*, MANAGEMENT_PORT, AWS_S3_RELEASES_BUCKET, UPDATE_SECRET, VISIT_LOG_MAX_SIZE,
# DEEP_LINK_BASE), and AWS_S3_BUCKET was flat-out the wrong name (the app reads S3_BUCKET) --
# anyone who filled in AWS_S3_BUCKET with S3 enabled would have silently gotten the default
# bucket name instead of the one they set.

# =========================
# DATABASE
# =========================
DB_URL=jdbc:postgresql://localhost:5432/opstool
DB_USER=opstool
DB_PASSWORD=changeme
DB_POOL_SIZE=20
DB_MIN_IDLE=5
DB_CONNECTION_TIMEOUT_MS=30000
# Leave unset unless a read replica actually exists (see docs/CONFIG-REFERENCE.md).
REPLICA_DB_URL=
# Local/CI default true; application-prod.properties overrides the default to false (migrations
# run as an explicit pre-deploy step in production, not implicitly at app boot). Leave unset.
FLYWAY_ENABLED=

# =========================
# REDIS
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =========================
# JWT / PASSWORD HASHING
# =========================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required — refused at boot in every environment if blank, the placeholder string, or under 256 bits.
JWT_SECRET=
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000
BCRYPT_STRENGTH=12

# =========================
# CORS
# =========================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =========================
# NETWORKING (reverse proxy)
# =========================
# CIDR(s) trusted to supply X-Forwarded-For. Required once deployed behind any reverse proxy/LB
# (e.g. OCI + Caddy) -- see docs/CONFIG-REFERENCE.md, this is boot-enforced in production.
TRUSTED_PROXY_CIDR=

# =========================
# PII FIELD-LEVEL ENCRYPTION (AES-256-GCM, required at startup when enabled)
# =========================
PII_ENCRYPTION_ENABLED=true
PII_ENCRYPTION_PROVIDER=local
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PII_ENCRYPTION_KEY_BASE64=
# Must be a DIFFERENT key from the one above -- do not reuse. If unset, falls back to deriving
# this key from PII_ENCRYPTION_KEY_BASE64 and logs a warning on every boot. Rotating this on a
# database with existing borrowers requires ONE run of LookupHashBackfillRunner
# (LOOKUP_HASH_BACKFILL=true, then back to false) to recompute existing lookup hashes.
PII_LOOKUP_HASH_KEY_BASE64=
# Only used when PII_ENCRYPTION_PROVIDER=kms.
PII_ENCRYPTION_KMS_REGION=
PII_ENCRYPTION_KMS_KEY_ID=
# One-time switch -- leave false; see comment on PII_LOOKUP_HASH_KEY_BASE64 above.
LOOKUP_HASH_BACKFILL=false

# =========================
# AWS / S3 (optional -- leave AWS_S3_ENABLED=false to use local-disk storage)
# =========================
AWS_S3_ENABLED=false
AWS_REGION=ap-south-1
S3_BUCKET=ops-tool-documents
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set to an S3-compatible endpoint (e.g. OCI Object Storage) to store there instead of real AWS.
AWS_S3_ENDPOINT_OVERRIDE=

# =========================
# FILE UPLOAD / LOCAL STORAGE / MALWARE SCANNING
# =========================
# Base directory for local-disk storage (used when AWS_S3_ENABLED=false) -- collections,
# rag-documents, sos-audio, visits, call-recordings, and kfs each get their own subdirectory
# under this. Bare-VM deployment: a real absolute path like /home/ubuntu/uploads. Docker
# deployment: mount a persistent volume and point this at the mount path -- without a volume,
# everything written here is lost on the container's next redeploy.
UPLOAD_DIR=/home/ubuntu/uploads
REPORTS_DIR=/home/ubuntu/reports
FILE_MAX_SIZE_BYTES=20971520
FILE_ALLOWED_TYPES=text/csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
# false (default) means uploaded files are never scanned for malware at all. Recommended true in
# production once a ClamAV daemon is reachable (SYSTEM 05).
CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

# =========================
# MAIL / OPS ALERTS
# =========================
# Best-effort everywhere in this app -- unset/rejected mail logs a warning and skips sending
# rather than failing a caller. See docs/CONFIG-REFERENCE.md for why this is deliberate.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
CONTACT_EMAIL_RECIPIENT=
# Who gets emailed when a background job (reconciliation, snapshots, PTP sweep, partition
# maintenance) fails -- falls back to CONTACT_EMAIL_RECIPIENT if unset. This is the entire
# alerting story for background-job failures; without either, a dead scheduled job only ever
# shows up in the log.
OPS_ALERT_RECIPIENT=
OPS_ALERT_COOLDOWN_MINUTES=30

# =========================
# PAYMENTS -- STRIPE
# =========================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Required if STRIPE_SECRET_KEY is set -- boot-enforced (WebhookSecretsStartupCheck).
STRIPE_WEBHOOK_SECRET=
STRIPE_TRIAL_DAYS=14
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
# Used by both Stripe and Razorpay checkout redirect URLs.
APP_BASE_URL=http://localhost:3000

# =========================
# PAYMENTS -- RAZORPAY
# =========================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required if RAZORPAY_KEY_ID/KEY_SECRET are set -- boot-enforced (WebhookSecretsStartupCheck).
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_TRIAL_DAYS=14
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_ENTERPRISE=

# =========================
# GST (Indian tax on RecoverPro's own SaaS invoices)
# =========================
GST_SUPPLIER_GSTIN=
GST_DEFAULT_RATE_BPS=1800

# =========================
# BUSINESS RULES
# =========================
GRIEVANCE_ACK_SLA_DAYS=3
GRIEVANCE_RESOLUTION_SLA_DAYS=30
SETTLEMENT_COMPLIANCE_THRESHOLD_PCT=30
MIS_EOD_CRON=0 0 20 * * *

# =========================
# LUCIEN AI (Ollama / Llama)
# =========================
LLAMA_BASE_URL=http://localhost:11434
LLAMA_MODEL=llama3
LLAMA_EMBEDDING_MODEL=nomic-embed-text
LLAMA_MAX_TOKENS=1024
LLAMA_TEMPERATURE=0.7
LLAMA_TOP_P=0.9
LLAMA_CONNECT_TIMEOUT_MS=5000
LLAMA_READ_TIMEOUT_MS=300000
LUCIEN_AGENT_MAX_ITERATIONS=8
LUCIEN_RATE_LIMIT_MAX=20
LUCIEN_RATE_LIMIT_WINDOW=60

# =========================
# LUCIEN VOICE (TTS/STT microservice -- backs the composer's mic button)
# =========================
TTS_BASE_URL=http://localhost:8100
TTS_CONNECT_TIMEOUT_MS=5000
TTS_READ_TIMEOUT_MS=60000

# =========================
# AWS SECRETS MANAGER (optional -- leave disabled to keep sourcing every secret from its own env
# var above, exactly as today; see docs/RUNBOOK-SECRETS.md before enabling)
# =========================
AWS_SECRETS_MANAGER_ENABLED=false
AWS_SECRETS_MANAGER_REGION=
AWS_SECRETS_MANAGER_PREFIX=recoverpro/
