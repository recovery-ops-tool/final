{
  "expo": {
    "name": "RecoverPro Field",
    "slug": "recoverpro-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "recoverprofield",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "bundleIdentifier": "com.recoverpro.field",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RecoverPro uses your location to verify field visits and attendance check-ins.",
        "NSCameraUsageDescription": "RecoverPro uses your camera to capture visit and collection receipt photos.",
        "NSMicrophoneUsageDescription": "RecoverPro records short audio clips only after you trigger an SOS alert, so your supervisor can hear what's happening."
      }
    },
    "android": {
      "package": "com.recoverpro.field",
      "adaptiveIcon": {
        "backgroundColor": "#0AA550",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0AA550",
          "image": "./assets/images/log.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RecoverPro uses your location to verify field visits and attendance check-ins."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "RecoverPro uses your camera to capture visit and collection receipt photos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "RecoverPro records short audio clips only after you trigger an SOS alert, so your supervisor can hear what's happening.",
          "enableBackgroundPlayback": false
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
