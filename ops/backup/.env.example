# Copy to ops/backup/.env (gitignored, never commit real values) and fill in before
# first deploy. Used by: the postgres container's archive_command (pg-wal-archive.sh),
# pg-backup.sh's nightly dump, and restore-test.sh's quarterly restore drill.
# This file is loaded into the postgres container itself (docker-compose.yml's
# `postgres.env_file`) -- pg-backup.sh runs via `docker compose exec postgres`, inside
# the container, using its localhost Postgres and its already-installed AWS CLI.

# Dedicated backup role -- BYPASSRLS, read-only, deliberately NOT the app's runtime
# role (opstool). Create once: see docs/RUNBOOK-DR.md TASK 41.1 finding for why.
PGHOST=localhost
PGPORT=5432
PGDATABASE=opstool
PGUSER=backup_agent
PGPASSWORD=

# OCI Object Storage bucket + S3-compatible endpoint that holds WAL segments and
# nightly dumps. Create the bucket with versioning enabled and a lifecycle rule
# that matches BACKUP_RETENTION_DAYS below (see docs/RUNBOOK-DR.md).
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=

# Credentials for a bucket-scoped OCI Object Storage user/key -- NOT the same
# credential as AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY used by the app's own
# S3OrLocalStoragePort (aws.s3.endpoint-override in application.properties). Keep
# backup write access separate from what the running app can reach: if the app is
# ever compromised, it should not be able to delete or overwrite backups.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-ashburn-1

# How long nightly logical dumps are kept before pg-backup.sh prunes them. WAL
# segments are pruned separately via the bucket's lifecycle rule, not this script.
BACKUP_RETENTION_DAYS=30
